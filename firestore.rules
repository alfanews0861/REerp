rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return request.auth.token;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin') || (
        isAuthenticated() && (
          request.auth.token.admin == true ||
          request.auth.token.email in [
            'admin@reerp.com', 
            'superadmin@reerp.com', 
            'satyadev.varma@reerp.com'
          ] ||
          request.auth.token.email.matches('.*admin.*@reerp\\.com')
        )
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || 
        hasRole('director') || 
        hasRole('branch_manager') ||
        (isAuthenticated() && (
          request.auth.token.email in [
            'manager@reerp.com', 
            'rajesh.kumar@reerp.com', 
            'raghava.rao@reerp.com', 
            'srinivas.murthy@reerp.com'
          ]
        ));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isTenantMember(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    function hasPermission(category, action) {
      return isAuthenticated() && (
        (category + ':' + action) in request.auth.token.permissions ||
        (category + ':*') in request.auth.token.permissions ||
        '*:*' in request.auth.token.permissions
      );
    }

    // System Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();

      // Multi-device sessions
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // System Audit Logs - append-only from clients, read by authenticated staff
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strict audit immutability
    }

    // Marketing Network & Commission Engine
    match /network_positions/{positionId} {
      allow read, write: if isAuthenticated();
    }
    
    match /network_members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    match /network_teams/{teamId} {
      allow read, write: if isAuthenticated();
    }

    match /commission_rules/{ruleId} {
      allow read, write: if isAuthenticated();
    }

    match /commission_pools/{poolId} {
      allow read, write: if isAuthenticated();
    }

    match /commission_records/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // Persons, Customers & CRM Interactions
    match /persons/{personId} {
      allow read, write: if isAuthenticated();
    }
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    match /interactions/{interactionId} {
      allow read, write: if isAuthenticated();
    }

    // Documents Vault & Media
    match /documents/{documentId} {
      allow read, write: if isAuthenticated();
    }
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // After-Sales Cases
    match /after_sales/{caseId} {
      allow read, write: if isAuthenticated();
    }

    // Customer Notifications & System Notifications
    match /customer_notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Materialized KPI Views
    match /dashboard_kpis/{kpiId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /processed_events/{eventId} {
        allow read, write: if false;
      }
    }

    // Projects, Layouts, Blocks & Plots Inventory
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /layouts/{layoutId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /blocks/{blockId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /plots/{plotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CRM Leads, Site Visits & Campaigns
    match /leads/{leadId} {
      allow create: if true; // Public inquiry submission from website/portal
      allow read, update, delete: if isAuthenticated();
    }
    match /lead_sources/{sourceId} {
      allow read, write: if isAuthenticated();
    }
    match /lead_activities/{activityId} {
      allow read, write: if isAuthenticated();
    }
    match /follow_ups/{followUpId} {
      allow read, write: if isAuthenticated();
    }
    match /site_visits/{visitId} {
      allow read, write: if isAuthenticated();
    }
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /campaign_expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Sales Bookings, Payments & Registrations
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
    match /receipts/{receiptId} {
      allow read, write: if isAuthenticated();
    }
    match /registrations/{registrationId} {
      allow read, write: if isAuthenticated();
    }

    // HR, Operations & Fleet
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
    }
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }
    match /vehicles/{vehicleId} {
      allow read, write: if isAuthenticated();
    }
    match /drivers/{driverId} {
      allow read, write: if isAuthenticated();
    }
    match /vehicle_trips/{tripId} {
      allow read, write: if isAuthenticated();
    }
    match /fuel_entries/{entryId} {
      allow read, write: if isAuthenticated();
    }
    match /events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // Organizations, Settings & RBAC Metadata
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /departments/{deptId} {
      allow read, write: if isAuthenticated();
    }
    match /designations/{desigId} {
      allow read, write: if isAuthenticated();
    }
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();
    }
    match /business_units/{unitId} {
      allow read, write: if isAuthenticated();
    }
    match /organization_settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    match /roles/{roleId} {
      allow read, write: if isAuthenticated();
    }
    match /permissions/{permId} {
      allow read, write: if isAuthenticated();
    }
    match /ai_suggestions/{suggestionId} {
      allow read, write: if isAuthenticated();
    }

    // Workflow Engine
    match /workflow_definitions/{defId} {
      allow read, write: if isAuthenticated();
    }
    match /workflow_instances/{instanceId} {
      allow read, write: if isAuthenticated();
    }
    match /workflow_histories/{historyId} {
      allow read, write: if isAuthenticated();
    }
    match /workflow_comments/{commentId} {
      allow read, write: if isAuthenticated();
    }

    // Authenticated fallback for all enterprise ERP collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
