rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return request.auth.token;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin') || (isAuthenticated() && request.auth.token.admin == true);
    }
    
    function isAdmin() {
      return isSuperAdmin() || hasRole('director') || hasRole('branch_manager');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isTenantMember(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    function hasPermission(category, action) {
      return isAuthenticated() && (
        (category + ':' + action) in request.auth.token.permissions ||
        (category + ':*') in request.auth.token.permissions ||
        '*:*' in request.auth.token.permissions
      );
    }

    // Baseline security fallback - deny all unhandled access
    match /{document=**} {
      allow read, write: if false; // Remove global superAdmin fallback to ensure explicit rules
    }
    
    // System Users collection baseline
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || isOwner(userId);
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin']));
      allow delete: if isSuperAdmin();

      // Multi-device sessions
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }
    
    // System Audit Logs - strictly immutable read-only for admins
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only written via Cloud Functions admin SDK
    }
    // Marketing Network & Commission Engine
    match /network_positions/{positionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('network', 'manage_positions');
    }
    
    match /network_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('network', 'manage_members');
    }

    match /network_teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('network', 'manage_teams');
    }

    match /commission_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('commission', 'manage_rules');
    }

    match /commission_pools/{poolId} {
      // Only admins and authorized finance can view all pools
      allow read: if isAdmin() || hasPermission('commission', 'view_ledger');
      allow write: if false; // Written only by Cloud Functions
    }

    match /commission_records/{recordId} {
      // Members can read their own commission records. Admins can read all.
      allow read: if isAdmin() || hasPermission('commission', 'view_ledger') || (isAuthenticated() && resource.data.networkMemberId == request.auth.uid);
      allow write: if false; // Written only by Cloud Functions
    }
    // Persons (Customers/Leads)
    match /persons/{personId} {
      allow read: if isAuthenticated() && (isAdmin() || hasPermission('customer', 'view') || isOwner(personId));
      allow write: if isAdmin() || hasPermission('customer', 'manage');
    }

    // Documents Vault
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        hasPermission('document', 'view') || 
        (resource.data.visibility == 'CUSTOMER_VISIBLE' && isOwner(resource.data.entityId))
      );
      allow write: if isAdmin() || hasPermission('document', 'manage');
    }

    // After-Sales Cases
    match /after_sales/{caseId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        hasPermission('after_sales', 'view') || 
        (resource.data.assignedTo == request.auth.uid) ||
        isOwner(resource.data.customerId)
      );
      allow write: if isAdmin() || hasPermission('after_sales', 'manage') || (isAuthenticated() && resource.data.assignedTo == request.auth.uid);
    }

    // Customer Notifications
    match /customer_notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Written only by Cloud Functions
    }

    // Materialized KPI Views
    match /dashboard_kpis/{kpiId} {
      allow read: if isAdmin() || hasPermission('dashboard', 'view');
      allow write: if false; // Only written by KPIAggregator Cloud Function
      
      match /processed_events/{eventId} {
        allow read, write: if false; // Internal idempotency tracker, backend only
      }
    }
  }
}
