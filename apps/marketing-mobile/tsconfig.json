{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "build"
  ]
}
