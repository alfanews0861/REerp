{
  "expo": {
    "name": "ISKON",
    "slug": "iskon-developers-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#02280B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.realestateerp.marketingmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02280B"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "marketing-mobile",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Marketing App to use your location."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Marketing App to access your camera."
        }
      ]
    ]
  }
}
