# Firebase Client Configuration (Admin Web & Public Website)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=real-estate-erp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=real-estate-erp
VITE_FIREBASE_STORAGE_BUCKET=real-estate-erp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=BExampleVapidKeyForWebPushMessaging1234567890

# Firebase Emulator Settings
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_HOST=localhost

# Cloud Functions API Endpoint Base URL
VITE_FUNCTIONS_BASE_URL=https://us-central1-real-estate-erp.cloudfunctions.net

# Application Metadata & Runtime Environment
VITE_APP_ENV=development
VITE_ENABLE_ANALYTICS=false
