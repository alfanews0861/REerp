{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --watch",
    "build:deploy": "node scripts/build-deployable.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@real-estate-erp/events": "workspace:*",
    "@real-estate-erp/firebase": "workspace:*",
    "@real-estate-erp/types": "workspace:*",
    "@real-estate-erp/utils": "workspace:*",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  }
}
